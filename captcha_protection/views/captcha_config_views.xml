<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="captcha_config_view_form" model="ir.ui.view">
        <field name="name">captcha.config.view.form</field>
        <field name="model">captcha.config</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="active"/>
                            <field name="purpose"/>
                            <field name="version"/>
                        </group>
                        <group>
                            <field name="site_key"/>
                            <field name="secret_key" password="True"/>
                            <field name="score_threshold" invisible="version != 'v3'"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="captcha_config_view_list" model="ir.ui.view">
        <field name="name">captcha.config.view.list</field>
        <field name="model">captcha.config</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="purpose"/>
                <field name="version"/>
                <field name="site_key"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="captcha_config_action" model="ir.actions.act_window">
        <field name="name">Captcha Settings</field>
        <field name="res_model">captcha.config</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_captcha_config"
              name="Captcha Settings"
              parent="base.menu_administration"
              action="captcha_config_action"
              groups="base.group_system"
              sequence="60"/>

</odoo>
