<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Self-contained: looks up its own active website_form config, so it
         can be t-called from any page template without controller support.
         Renders nothing unless that config is version v2 - v3 is already
         handled transparently by ir_http.py's session_info/verify hooks,
         reusing Odoo core's own website-form-builder JS as-is. -->
    <template id="website_form_v2_widget" name="Website Form v2 Captcha Widget">
        <t t-set="_wf_captcha_config" t-value="request.env['captcha.config'].sudo().get_active_config(purpose='website_form')"/>
        <t t-if="_wf_captcha_config and _wf_captcha_config.version == 'v2'">
            <div class="mb-3 s_website_form_field">
                <script src="https://www.google.com/recaptcha/api.js" async="async" defer="defer"/>
                <div class="g-recaptcha" t-att-data-sitekey="_wf_captcha_config.site_key"/>
                <!-- Runs synchronously at parse time, before core's Form
                     interaction (OWL, mounts after DOM ready) can attach -
                     stops it from also trying its own v3 flow on this form
                     with a v2 key, which would fail to load entirely. -->
                <script>document.currentScript.closest('form').classList.add('s_website_form_no_recaptcha');</script>
            </div>
        </t>
    </template>

    <template id="contact_us_captcha" inherit_id="website_innovax.contactus_innovax" name="Contact Us Captcha">
        <xpath expr="//div[hasclass('s_website_form_submit')]" position="before">
            <t t-call="captcha_protection.website_form_v2_widget"/>
        </xpath>
    </template>

    <!-- website_helpdesk.ticket_submit_form is the module's default
         template, but each helpdesk.team's website_form_view_id points at
         its own fully independent view (inherit_id=False) once a team
         exists - confirmed on this site: team_form_1..4 do NOT inherit from
         ticket_submit_form at all. Both are targeted: the generic one as a
         fallback (e.g. a team reset to default, or before its own view is
         generated), and each team's own view so the widget actually reaches
         the pages that are really being served. Any team added later that
         gets its own fresh independent view will need a matching entry
         added here too. -->
    <template id="helpdesk_ticket_captcha" inherit_id="website_helpdesk.ticket_submit_form" name="Helpdesk Ticket Captcha">
        <xpath expr="//div[hasclass('s_website_form_submit')]" position="before">
            <t t-call="captcha_protection.website_form_v2_widget"/>
        </xpath>
    </template>

    <template id="helpdesk_ticket_captcha_team_1" inherit_id="website_helpdesk.team_form_1" name="Helpdesk Ticket Captcha (Team 1)">
        <xpath expr="//div[hasclass('s_website_form_submit')]" position="before">
            <t t-call="captcha_protection.website_form_v2_widget"/>
        </xpath>
    </template>

    <template id="helpdesk_ticket_captcha_team_2" inherit_id="website_helpdesk.team_form_2" name="Helpdesk Ticket Captcha (Team 2)">
        <xpath expr="//div[hasclass('s_website_form_submit')]" position="before">
            <t t-call="captcha_protection.website_form_v2_widget"/>
        </xpath>
    </template>

    <template id="helpdesk_ticket_captcha_team_3" inherit_id="website_helpdesk.team_form_3" name="Helpdesk Ticket Captcha (Team 3)">
        <xpath expr="//div[hasclass('s_website_form_submit')]" position="before">
            <t t-call="captcha_protection.website_form_v2_widget"/>
        </xpath>
    </template>

    <template id="helpdesk_ticket_captcha_team_4" inherit_id="website_helpdesk.team_form_4" name="Helpdesk Ticket Captcha (Team 4)">
        <xpath expr="//div[hasclass('s_website_form_submit')]" position="before">
            <t t-call="captcha_protection.website_form_v2_widget"/>
        </xpath>
    </template>

</odoo>
